---
layout: layout.njk
aktiv: omoss
pagination:
  data: locales
  size: 1
  alias: loc
permalink: "/{{ loc.prefix }}om-oss/index.html"
eleventyComputed:
  titel: "{{ pages[loc.code].omoss.navnamn }}"
  beskrivning: "{{ pages[loc.code].omoss.hero.undertitel }}"
  heroBild: "{{ pages[loc.code].omoss.hero.bild }}"
---
{%- set kod = loc.code -%}
{%- set sidan = pages[kod].omoss -%}

<section class="subpage-hero subpage-hero--about"{% if sidan.hero.bild %} style="background-image: linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.55)), url('{{ sidan.hero.bild | url }}'); background-size: cover; background-position: center;"{% endif %}>
    <h1>{{ sidan.hero.rubrik }}</h1>
    <p>{{ sidan.hero.undertitel }}</p>
</section>

<section class="section">
    {{ sidan.body | safe }}
</section>
